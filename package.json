{
  "name": "teleprompter",
  "productName": "Teleprompter",
  "version": "1.0.0",
  "description": "Teleprompter para uso interno da Chiaro Filmes",
  "author": "Chiaro Filmes",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "homepage": "https://github.com/audiovisualpecege/teleprompter",
  "repository": {
    "type": "git",
    "url": "https://github.com/audiovisualpecege/teleprompter.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:test": "electron-vite build --mode test",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "icons": "node scripts/gerar-icones.mjs",
    "test": "vitest run --project node --project dom",
    "test:voice": "vitest run --project voice --passWithNoTests",
    "test:e2e": "npm run build:test && playwright test",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "electron-log": "^5.4.4",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sherpa-onnx-node": "2.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vosk-browser": "0.0.8",
    "yaml": "^2.9.1"
  }
}
